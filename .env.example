# Copy this file to .env for local development. All values here are safe to
# ship publicly — the Supabase key is the publishable (anon) key and every
# sensitive table is locked down with RLS + server-only functions.

# Supabase
SUPABASE_PROJECT_ID="oryxjnvbglscrdjtjnbd"
SUPABASE_URL="https://oryxjnvbglscrdjtjnbd.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_gTWG0-vNP-Nu5SmKE1qB4Q_mf7meiHq"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Same values re-exposed to the browser via Vite
VITE_SUPABASE_PROJECT_ID="oryxjnvbglscrdjtjnbd"
VITE_SUPABASE_URL="https://oryxjnvbglscrdjtjnbd.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_gTWG0-vNP-Nu5SmKE1qB4Q_mf7meiHq"

# Admin dashboard password (/admin and /mixman)
ADMIN_PASSWORD="Choose"

# Thirdweb Bridge client id (public — safe to expose)
THIRDWEB_CLIENT_ID="f5eb45838e1432573c621a486d7095da"

# Telegram bot token used by /api/public/notify to mirror site events
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_WEBHOOK_SECRET="your_random_webhook_secret_here"
TELEGRAM_CHAT_ID="-1003957750577"

# Gmail used to email users about withdrawals (set real values in Netlify/Project secrets, never commit the app password)
SMTP_USER="primecapitalsupportchat@gmail.com"
SMTP_PASS="your_gmail_app_password_here"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
